---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Share Feedback"
  description="Share your ideas, thoughts, and suggestions for the Sheffield Speakers website."
>
  <section class="py-16 bg-gray-50 min-h-[calc(100vh-200px)]">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4 text-loyal-blue">
          Share Your Feedback
        </h1>
        <p class="font-body text-lg text-gray-700 mb-10">
          Have an idea, suggestion, or thought about the website? We'd love to hear it. All feedback is anonymous.
        </p>

        <div id="form-container" class="bg-white p-8 rounded-lg shadow-sm">
          <form
            name="website-feedback"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            id="feedback-form"
          >
            <input type="hidden" name="form-name" value="website-feedback" />
            <p class="hidden">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="mb-6">
              <label for="category" class="block font-body font-semibold text-loyal-blue mb-2">
                What type of feedback is this?
              </label>
              <select
                id="category"
                name="category"
                required
                class="w-full border border-gray-300 rounded px-4 py-2 font-body text-gray-700 focus:outline-none focus:ring-2 focus:ring-loyal-blue"
              >
                <option value="" disabled selected>Select a category</option>
                <option value="idea">New idea or feature</option>
                <option value="improvement">Improvement to existing content</option>
                <option value="bug">Something isn't working</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="mb-8">
              <label for="message" class="block font-body font-semibold text-loyal-blue mb-2">
                Your feedback
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                placeholder="Share your thoughts here..."
                class="w-full border border-gray-300 rounded px-4 py-2 font-body text-gray-700 focus:outline-none focus:ring-2 focus:ring-loyal-blue resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="bg-true-maroon text-white font-body font-semibold px-6 py-3 rounded hover:bg-opacity-90 transition-colors w-full"
            >
              Submit Feedback
            </button>
          </form>
        </div>

        <div id="success-message" class="hidden bg-white p-8 rounded-lg shadow-sm text-center">
          <svg class="mx-auto mb-4 w-12 h-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h2 class="font-heading text-2xl font-bold text-loyal-blue mb-2">Thank you!</h2>
          <p class="font-body text-gray-700">Your feedback has been submitted. We appreciate you helping to improve the website.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement | null;
  const formContainer = document.getElementById('form-container');
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const response = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data as any).toString(),
    });

    if (response.ok) {
      formContainer?.classList.add('hidden');
      successMessage?.classList.remove('hidden');
    } else {
      alert('Something went wrong. Please try again.');
    }
  });
</script>